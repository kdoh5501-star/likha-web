# Vercel → Project → Settings → Environment Variables 에 등록 (Git에 올리지 말 것)
TOSS_SECRET_KEY=test_gsk_xxxxxxxxxxxxxxxxxxxxxxxx     # 토스 개발자센터 → 결제위젯 연동 키 → 시크릿 키 (운영: live_gsk_)
SUPABASE_URL=https://xxxxxxxx.supabase.co            # Supabase → Project Settings → API
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...               # service_role (서버 전용! anon 키와 다름)
DEEPL_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx:fx # DeepL API Free (무료 월 50만자). 선택
GOOGLE_TRANSLATE_KEY=                                 # 타갈로그 번역용 (선택). 없으면 영어로 대체
ALLOWED_ORIGIN=https://likha.kr                       # CORS. 개발 중에는 * 로
